# Copy to .env.local and fill in. Never commit .env.local - this repo is public.

# Postgres connection string, from the Supabase dashboard: Connect ->
# Transaction pooler. Replace [YOUR-PASSWORD] with the database password.
#
# We connect directly rather than through the Data API. This app has no browser
# client, no auth and no RLS policies, so PostgREST was a browser-facing layer
# we carried without using. Going direct means the Data API can stay switched
# off entirely, which is the right posture for a database holding people's
# search history.
#
# Transaction-mode pooling is the right fit for serverless, and the client sets
# prepare: false accordingly.
DATABASE_URL=


# Recorded against every consent grant so a grant can be traced back to the
# exact disclosure the respondent saw. Bump when the consent copy changes.
NEXT_PUBLIC_DISCLOSURE_VERSION=2026-08-04
