# Copy to .env.local and fill in. Never commit .env.local - this repo is public.

# Supabase. Both are server-only on purpose: the browser has no Supabase client
# and never should, so neither of these is NEXT_PUBLIC_. Released records reach
# us through /api/release, not through PostgREST.
#
# In the project's API settings, leave "Automatically expose new tables" off.
# Grants are handled explicitly in supabase/migrations/0003_grants.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Identifies the study a session belongs to.
NEXT_PUBLIC_STUDY_ID=dev

# Version string recorded against every consent grant, so a grant can always be
# traced back to the exact disclosure the respondent was shown. Bump whenever
# the consent copy changes.
NEXT_PUBLIC_DISCLOSURE_VERSION=2026-08-04
